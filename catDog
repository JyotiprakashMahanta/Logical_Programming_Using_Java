public boolean catDog(String str) {
  int cat=0,dog=0;
  for(int i=0;i<=str.length()-3;i++){
    //str.charAt(i)=='c' && str.charAt(i+1)=='a' && str.charAt(i+2)=='t'
    if(str.startsWith("cat",i)){
      cat++;
    }
    //str.charAt(i)=='d' && str.charAt(i+1)=='o' && str.charAt(i+2)=='g'
    if(str.startsWith("dog",i)){
      dog++;
    }
  }
  return cat==dog;
}
